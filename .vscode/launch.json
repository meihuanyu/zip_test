{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "运行 main.py (uv)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "runtimeExecutable": "uv",
            "runtimeArgs": [
                "run",
                "python"
            ]
        }
    ]
}


